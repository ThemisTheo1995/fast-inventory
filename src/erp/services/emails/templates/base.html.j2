<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <title>{% block subject %}Aegis Notification{% endblock %}</title>
  
  <style type="text/css">
    /* -------------------------------------------
       1. CORE RESETS
       ------------------------------------------- */
    :root { color-scheme: light dark; supported-color-schemes: light dark; }
    
    /* Stop email clients resizing small text */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    
    /* Remove spacing between tables in Outlook */
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    
    /* Allow smoother rendering of resized images in Internet Explorer */
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    
    /* Reset layout */
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; }

    /* Force table cells to break long strings */
    td, th { word-break: break-word; overflow-wrap: break-word; }

    /* iOS Blue Links override */
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }

    /* Gmail Blue Links override */
    u + #body a { color: inherit; text-decoration: none; font-size: inherit; font-family: inherit; font-weight: inherit; line-height: inherit; }
    
    /* Samsung Mail Blue Links override */
    #MessageViewBody a { color: inherit; text-decoration: none; font-size: inherit; font-family: inherit; font-weight: inherit; line-height: inherit; }

    /* -------------------------------------------
       2. RESPONSIVE HELPERS
       ------------------------------------------- */
    @media screen and (max-width: 600px) {
      .responsive-table { width: 100% !important; max-width: 100% !important; }
      .mobile-padding-outer { padding: 16px 8px !important; }
      .mobile-padding-inner { padding: 24px 16px !important; }
      .mobile-btn { width: 100% !important; display: block !important; box-sizing: border-box !important; }
    }

    /* -------------------------------------------
       3. DARK MODE (Automatic for supported clients)
       ------------------------------------------- */
    @media (prefers-color-scheme: dark) {
      .theme-bg { background-color: #0f172a !important; } /* Tailwind slate-900 */
      .theme-card { background-color: #1e293b !important; border-color: #334155 !important; } /* slate-800, border slate-700 */
      .theme-text-main { color: #f8fafc !important; } /* slate-50 */
      .theme-text-muted { color: #94a3b8 !important; } /* slate-400 */
      .theme-strong { color: #f8fafc !important; }
      .theme-divider { border-top-color: #334155 !important; }
      .theme-logo { color: #ffffff !important; }
      
      /* Target Outlook Dark Mode */
      [data-ogsc] .theme-bg { background-color: #0f172a !important; }
      [data-ogsc] .theme-card { background-color: #1e293b !important; border-color: #334155 !important; }
      [data-ogsc] .theme-text-main { color: #f8fafc !important; }
      [data-ogsc] .theme-text-muted { color: #94a3b8 !important; }
    }

    /* Preheader hiding */
    .preheader { display: none !important; visibility: hidden; mso-hide: all; font-size: 1px; line-height: 1px; max-height: 0; max-width: 0; opacity: 0; overflow: hidden; }
  </style>
</head>
<body id="body" class="theme-bg" style="margin: 0 !important; padding: 0 !important; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol';">
  
  <!-- Hidden Preheader Text -->
  <span class="preheader">{% block preheader %}{% endblock %}</span>
  
  <!-- Hack for Gmail App to force full width rendering -->
  <div style="display: none; max-height: 0px; overflow: hidden;">
    &#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;&#8475;
  </div>

  <!-- Background Wrapper -->
  <table border="0" cellpadding="0" cellspacing="0" width="100%" class="theme-bg" style="background-color: #f1f5f9; min-width: 100%;">
    <tr>
      <td align="center" class="mobile-padding-outer" style="padding: 48px 16px;">
        
        <!-- [OUTLOOK GHOST TABLE - START] -->
        <!--[if (gte mso 9)|(IE)]>
        <table align="center" border="0" cellspacing="0" cellpadding="0" width="600" style="width:600px;">
        <tr>
        <td align="center" valign="top" width="600" style="width:600px;">
        <![endif]-->

        <!-- Max Width Outer Container -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" class="responsive-table theme-card" style="max-width: 600px; width: 100%; table-layout: fixed; background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; border-collapse: separate;">
          
          <!-- Outer Padding Wrapper Cell -->
          <tr>
            <td class="mobile-padding-inner" style="padding: 40px 32px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                
                <!-- Logo Header -->
                <tr>
                  <td align="center" style="padding-bottom: 32px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td align="center" class="theme-logo" style="font-size: 24px; font-weight: 900; letter-spacing: 0.03em; color: #0f172a; mso-line-height-rule: exactly; line-height: 24px;">
                          AEGIS<span style="color: #3b82f6;">.</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Main Jinja Content -->
                <tr>
                  <td>
                    {% block content %}
                    {% endblock %}
                  </td>
                </tr>

                <!-- Standardized Footer -->
                <tr>
                  <td align="center" style="padding-top: 32px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td align="center" class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; color: #64748b;">
                          &copy; {{ current_year | default(2026) }} Aegis ERP. All rights reserved.<br />
                          Secure Workspace Synchronization
                        </td>
                      </tr>
                      
                      {% if unsubscribe_url %}
                      <tr>
                        <td align="center" style="padding-top: 12px;">
                          <a href="{{ unsubscribe_url }}" class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #64748b; text-decoration: underline;">
                            Unsubscribe from workspace alerts
                          </a>
                        </td>
                      </tr>
                      {% else %}
                      <tr>
                        <td align="center" class="theme-text-muted" style="padding-top: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #64748b;">
                          This is a mandatory operational email.
                        </td>
                      </tr>
                      {% endif %}
                    </table>
                  </td>
                </tr>

              </table>
            </td>
          </tr>
        </table>

        <!-- [OUTLOOK GHOST TABLE - END] -->
        <!--[if (gte mso 9)|(IE)]>
        </td>
        </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>
