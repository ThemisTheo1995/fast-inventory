{% extends "base.html.j2" %}

{% block subject %}Reset your Aegis account password{% endblock %}

{% block preheader %}We received a password reset request for your Aegis workspace. Use the link inside to choose a new password.{% endblock %}

{% block content %}
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
  <!-- Header -->
  <tr>
    <td class="theme-text-main" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 800; color: #0f172a; padding-bottom: 12px; letter-spacing: -0.025em;">
      Password Reset Request
    </td>
  </tr>
  <tr>
    <td class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 15px; color: #475569; line-height: 1.6; padding-bottom: 24px;">
      Hi {{ user_name }}, we received a request to reset the password associated with your Aegis workspace account. Click the button below to proceed.
    </td>
  </tr>

  <!-- Primary CTA Button -->
  <tr>
    <td align="center" style="padding-bottom: 28px;">
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="mobile-btn">
        <tr>
          <td align="center" style="border-radius: 8px; background-color: #3b82f6;">
            <a href="{{ action_url }}" target="_blank" class="mobile-btn" style="display: inline-block; padding: 14px 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 8px;">
              Reset Password
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Divider -->
  <tr>
    <td style="padding-bottom: 24px;">
      <hr class="theme-divider" style="border: 0; border-top: 1px solid #e2e8f0; margin: 0;" />
    </td>
  </tr>

  <!-- Security Details Header -->
  <tr>
    <td class="theme-text-main" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; font-weight: 700; color: #0f172a; text-transform: uppercase; letter-spacing: 0.05em; padding-bottom: 16px;">
      Security Notice
    </td>
  </tr>

  <!-- Expiration -->
  <tr>
    <td class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; color: #334155; line-height: 1.6; padding-bottom: 10px;">
      <strong class="theme-strong" style="color: #0f172a;">Time-Sensitive Link:</strong> This password reset link will expire in <strong>5 minutes</strong>.
    </td>
  </tr>

  <!-- Ignored Request -->
  <tr>
    <td class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 14px; color: #334155; line-height: 1.6; padding-bottom: 24px;">
      <strong class="theme-strong" style="color: #0f172a;">Didn't request this change?</strong> You can safely ignore this email. Your current password will remain active and secure.
    </td>
  </tr>

  <!-- Fallback Link -->
  <tr>
    <td class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; color: #94a3b8; line-height: 1.5; padding-bottom: 24px; word-break: break-all;">
      If the button above does not work, copy and paste this URL into your browser:<br />
      <a href="{{ action_url }}" style="color: #3b82f6; text-decoration: underline;">{{ action_url }}</a>
    </td>
  </tr>

  <!-- Divider -->
  <tr>
    <td style="padding-bottom: 20px;">
      <hr class="theme-divider" style="border: 0; border-top: 1px solid #e2e8f0; margin: 0;" />
    </td>
  </tr>

  <!-- Support Contact Section -->
  <tr>
    <td class="theme-text-muted" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px; color: #64748b; line-height: 1.6;">
      <strong class="theme-strong" style="color: #0f172a;">Need additional assistance?</strong><br />
      If you suspect unauthorized access to your account, please contact our security team immediately at 
      <a href="mailto:{{ support_email }}" style="color: #3b82f6; text-decoration: underline;">
        {{ support_email }}
      </a>.
    </td>
  </tr>
</table>
{% endblock %}
